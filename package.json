{
  "name": "innovation-ecosystem-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:realtime": "npm --prefix apps/realtime run dev",
    "build:shared": "npm --prefix packages/shared-types run build",
    "build:ui": "npm --prefix packages/ui run build",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "build:realtime": "npm --prefix apps/realtime run build",
    "build:all": "npm run build:shared && npm run build:ui && npm run build:api && npm run build:realtime && npm run build:web"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "browserslist": "^4.28.7"
  }
}
