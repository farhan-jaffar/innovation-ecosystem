generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GOVERNMENT
  UNIVERSITY
  COMPANY
  INDIVIDUAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

enum CompanyStage {
  STARTUP
  SME
  ENTERPRISE
}

enum IndividualAvailability {
  OPEN_TO_WORK
  BUSY
  NOT_AVAILABLE
}

enum ProjectType {
  GOVERNMENT_CHALLENGE
  INDUSTRY_CHALLENGE
  RESEARCH_OPPORTUNITY
  HACKATHON
  COMPETITION
  FUNDING_OPPORTUNITY
  COLLABORATION_REQUEST
  OPEN_SOURCE_PROJECT
}

enum OpportunityStatus {
  DRAFT
  OPEN
  IN_REVIEW
  FUNDED
  CLOSED
  COMPLETED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWED
  SHORTLISTED
  ACCEPTED
  REJECTED
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  username      String      @unique
  passwordHash  String
  role          Role
  status        UserStatus  @default(ACTIVE)
  emailVerified Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  governmentProfile GovernmentProfile?
  universityProfile UniversityProfile?
  companyProfile    CompanyProfile?
  individualProfile IndividualProfile?

  opportunities PostedOpportunity[]
  applications  Application[]
  bookmarks     Bookmark[]
}

model GovernmentProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName   String
  ministry           String
  jurisdiction       String
  website            String?
  logo               String?
  contactEmail       String
  contactPhone       String?
  verificationStatus String   @default("VERIFIED")
  nationalFocusAreas String[]
}

model UniversityProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  country            String   @default("Pakistan")
  city               String
  ranking            String?
  accreditation      String?
  departments        String[]
  facultiesCount     Int?     @default(0)
  labsCount          Int?     @default(0)
  incubators         String[]
  website            String?
  logo               String?
  verificationStatus String   @default("VERIFIED")
}

model CompanyProfile {
  id                 String       @id @default(uuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  industry           String
  size               String
  stage              CompanyStage @default(STARTUP)
  description        String
  website            String?
  logo               String?
  verificationStatus String       @default("VERIFIED")
  techStack          String[]
}

model IndividualProfile {
  id                String                 @id @default(uuid())
  userId            String                 @unique
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  headline          String
  bio               String
  education         Json                   @default("[]")
  experience        Json                   @default("[]")
  skills            String[]
  researchInterests String[]
  githubUrl         String?
  portfolioUrl      String?
  linkedinUrl       String?
  availability      IndividualAvailability @default(OPEN_TO_WORK)
}

model PostedOpportunity {
  id                String            @id @default(uuid())
  title             String
  description       String
  type              ProjectType
  postedBy          String
  poster            User              @relation(fields: [postedBy], references: [id], onDelete: Cascade)
  domain            String
  budget            Float?
  currency          String            @default("PKR")
  budgetType        String            @default("FIXED")
  deadline          DateTime
  duration          String?
  requiredSkills    String[]
  requiredRoles     String[]
  status            OpportunityStatus @default(OPEN)
  visibility        String            @default("PUBLIC")
  attachments       String[]
  tags              String[]
  milestones        Json              @default("[]")
  featured          Boolean           @default(false)
  viewCount         Int               @default(0)
  applicationCount  Int               @default(0)
  collaboratorCount Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  applications Application[]
  bookmarks    Bookmark[]
}

model Application {
  id               String            @id @default(uuid())
  opportunityId    String
  opportunity      PostedOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantId      String
  applicant        User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  coverLetter      String
  proposedApproach String
  proposedBudget   Float?
  proposedTimeline String?
  attachments      String[]
  status           ApplicationStatus @default(SUBMITTED)
  reviewNotes      String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Bookmark {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   PostedOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())

  @@unique([userId, opportunityId])
}
