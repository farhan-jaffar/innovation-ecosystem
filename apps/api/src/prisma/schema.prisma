generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GOVERNMENT
  UNIVERSITY
  COMPANY
  INDIVIDUAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

enum CompanyStage {
  STARTUP
  SME
  ENTERPRISE
}

enum IndividualAvailability {
  OPEN_TO_WORK
  BUSY
  NOT_AVAILABLE
}

enum ProjectType {
  GOVERNMENT_CHALLENGE
  INDUSTRY_CHALLENGE
  RESEARCH_OPPORTUNITY
  HACKATHON
  COMPETITION
  FUNDING_OPPORTUNITY
  COLLABORATION_REQUEST
  OPEN_SOURCE_PROJECT
}

enum OpportunityStatus {
  DRAFT
  OPEN
  IN_REVIEW
  FUNDED
  CLOSED
  COMPLETED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWED
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum PublicationType {
  PAPER
  PATENT
  DATASET
  PROTOTYPE
  IDEA
}

enum AccessType {
  OPEN
  RESTRICTED
  COMMERCIAL
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  RESEARCH_POSITION
  CONTRACT
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  EXPERT
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum JobApplicationStatus {
  APPLIED
  SCREENED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum FundingType {
  GRANT
  SCHOLARSHIP
  INNOVATION_CHALLENGE
  SEED_FUNDING
  RD_FUNDING
}

enum FundingEligibility {
  INDIVIDUAL
  UNIVERSITY
  STARTUP
  COMPANY
  ANY
}

enum FundingOpportunityStatus {
  DRAFT
  OPEN
  EVALUATION
  CLOSED
  AWARDED
}

enum FundingProposalStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  APPROVED
  REJECTED
}

enum StartupStage {
  IDEA
  PROTOTYPE
  MVP
  GROWTH
  SCALE
}

enum OriginType {
  UNIVERSITY_RESEARCH
  PERSONAL
  CORPORATE_SPINOFF
}

enum MentorshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  username      String      @unique
  passwordHash  String
  role          Role
  status        UserStatus  @default(ACTIVE)
  emailVerified Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  governmentProfile GovernmentProfile?
  universityProfile UniversityProfile?
  companyProfile    CompanyProfile?
  individualProfile IndividualProfile?

  opportunities PostedOpportunity[]
  applications  Application[]
  bookmarks     Bookmark[]
  researches    Research[]
  jobPostings   JobPosting[]
  jobApps       JobApplication[]
  fundingOpps   FundingOpportunity[]
  proposals     FundingProposal[]
}

model GovernmentProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName   String
  ministry           String
  jurisdiction       String
  website            String?
  logo               String?
  contactEmail       String
  contactPhone       String?
  verificationStatus String   @default("VERIFIED")
  nationalFocusAreas String[]
}

model UniversityProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  country            String   @default("Pakistan")
  city               String
  ranking            String?
  accreditation      String?
  departments        String[]
  facultiesCount     Int?     @default(0)
  labsCount          Int?     @default(0)
  incubators         String[]
  website            String?
  logo               String?
  verificationStatus String   @default("VERIFIED")
}

model CompanyProfile {
  id                 String       @id @default(uuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  industry           String
  size               String
  stage              CompanyStage @default(STARTUP)
  description        String
  website            String?
  logo               String?
  verificationStatus String       @default("VERIFIED")
  techStack          String[]
}

model IndividualProfile {
  id                String                 @id @default(uuid())
  userId            String                 @unique
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  headline          String
  bio               String
  education         Json                   @default("[]")
  experience        Json                   @default("[]")
  skills            String[]
  researchInterests String[]
  githubUrl         String?
  portfolioUrl      String?
  linkedinUrl       String?
  availability      IndividualAvailability @default(OPEN_TO_WORK)
}

model PostedOpportunity {
  id                String            @id @default(uuid())
  title             String
  description       String
  type              ProjectType
  postedBy          String
  poster            User              @relation(fields: [postedBy], references: [id], onDelete: Cascade)
  domain            String
  budget            Float?
  currency          String            @default("PKR")
  budgetType        String            @default("FIXED")
  deadline          DateTime
  duration          String?
  requiredSkills    String[]
  requiredRoles     String[]
  status            OpportunityStatus @default(OPEN)
  visibility        String            @default("PUBLIC")
  attachments       String[]
  tags              String[]
  milestones        Json              @default("[]")
  featured          Boolean           @default(false)
  viewCount         Int               @default(0)
  applicationCount  Int               @default(0)
  collaboratorCount Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  applications Application[]
  bookmarks    Bookmark[]
}

model Application {
  id               String            @id @default(uuid())
  opportunityId    String
  opportunity      PostedOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantId      String
  applicant        User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  coverLetter      String
  proposedApproach String
  proposedBudget   Float?
  proposedTimeline String?
  attachments      String[]
  status           ApplicationStatus @default(SUBMITTED)
  reviewNotes      String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Bookmark {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   PostedOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())

  @@unique([userId, opportunityId])
}

model Research {
  id                String          @id @default(uuid())
  title             String
  abstract          String
  pdfUrl            String?
  authors           String[]
  affiliations      String[]
  domain            String
  subDomain         String?
  keywords          String[]
  publicationType   PublicationType @default(PAPER)
  publishedDate     DateTime
  journalName       String?
  doi               String?
  externalUrl       String?
  license           String          @default("CC BY 4.0")
  accessType        AccessType      @default(OPEN)
  citations         Int             @default(0)
  downloads         Int             @default(0)
  views             Int             @default(0)
  collaborationOpen Boolean         @default(true)
  fundingRequest    Boolean         @default(false)
  fundingAmount     Float?
  status            String          @default("PUBLISHED")
  postedBy          String
  poster            User            @relation(fields: [postedBy], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  collabInquiries ResearchCollabInquiry[]
}

model ResearchCollabInquiry {
  id           String   @id @default(uuid())
  researchId   String
  research     Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  inquirerId   String
  inquiryType  String   @default("COMMERCIALIZATION")
  message      String
  contactEmail String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}

model JobPosting {
  id                  String          @id @default(uuid())
  companyId           String
  poster              User            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title               String
  description         String
  type                JobType         @default(FULL_TIME)
  domain              String
  requiredSkills      String[]
  preferredSkills     String[]
  experienceLevel     ExperienceLevel @default(MID)
  salaryMin           Float?
  salaryMax           Float?
  currency            String          @default("PKR")
  salaryType          String          @default("MONTHLY")
  location            String
  remote              Boolean         @default(false)
  hybrid              Boolean         @default(false)
  applicationDeadline DateTime
  startDate           DateTime?
  perks               String[]
  responsibilities    String[]
  requirements        String[]
  status              JobStatus       @default(ACTIVE)
  viewCount           Int             @default(0)
  applicantCount      Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  applications JobApplication[]
}

model JobApplication {
  id            String               @id @default(uuid())
  jobId         String
  job           JobPosting           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId   String
  applicant     User                 @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  coverLetter   String
  resumeUrl     String?
  status        JobApplicationStatus @default(APPLIED)
  notes         String?
  interviewDate DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  recommendations UniversityRecommendation[]
}

model UniversityRecommendation {
  id               String         @id @default(uuid())
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  universityId     String
  studentId        String
  note             String
  createdAt        DateTime       @default(now())
}

model FundingOpportunity {
  id                  String                   @id @default(uuid())
  funderId            String
  funder              User                     @relation(fields: [funderId], references: [id], onDelete: Cascade)
  title               String
  description         String
  type                FundingType              @default(GRANT)
  amount              Float
  currency            String                   @default("PKR")
  fundingType         String                   @default("MILESTONE_BASED")
  eligibility         FundingEligibility       @default(ANY)
  domain              String
  requirements        String[]
  applicationDeadline DateTime
  projectStartDate    DateTime?
  projectEndDate      DateTime?
  maxApplicants       Int?
  documentsRequired   String[]
  status              FundingOpportunityStatus @default(OPEN)
  viewCount           Int                      @default(0)
  proposalCount       Int                      @default(0)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  proposals FundingProposal[]
}

model FundingProposal {
  id                  String                @id @default(uuid())
  fundingId           String
  funding             FundingOpportunity    @relation(fields: [fundingId], references: [id], onDelete: Cascade)
  applicantId         String
  applicant           User                  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  proposalTitle       String
  proposalDescription String
  budget              Float
  timeline            String
  milestones          Json                  @default("[]")
  teamMembers         String[]
  attachments         String[]
  status              FundingProposalStatus @default(SUBMITTED)
  reviewerNotes       String?
  approvedAmount      Float?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  fundedProjects FundedProject[]
}

model FundedProject {
  id                    String          @id @default(uuid())
  proposalId            String          @unique
  proposal              FundingProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  fundingTitle          String
  recipientName         String
  totalGrant            Float
  disbursedAmount       Float           @default(0)
  currentMilestoneIndex Int             @default(0)
  milestones            Json            @default("[]")
  disbursements         Json            @default("[]")
  progressReports       String[]
  status                String          @default("ACTIVE")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model Startup {
  id                 String       @id @default(uuid())
  founderIds         String[]
  founderUsernames   String[]
  name               String
  tagline            String
  description        String
  industry           String
  stage              StartupStage @default(MVP)
  foundedDate        DateTime     @default(now())
  country            String       @default("Pakistan")
  city               String
  logo               String?
  website            String?
  pitchDeckUrl       String?
  demoUrl            String?
  teamSize           Int          @default(1)
  revenueRange       String       @default("PRE_REVENUE")
  fundingRaised      Float        @default(0)
  currency           String       @default("PKR")
  originType         OriginType   @default(UNIVERSITY_RESEARCH)
  linkedResearchIds  String[]
  linkedUniversityId String?
  universityName     String?
  status             String       @default("ACTIVE")
  viewCount          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  mentorshipRequests MentorshipRequest[]
}

model MentorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  username       String   @unique
  fullName       String
  title          String
  company        String
  expertise      String[]
  industries     String[]
  mentorshipType String   @default("FREE")
  hourlyRate     Float?
  maxMentees     Int      @default(5)
  activeMentees  Int      @default(0)
  availability   String   @default("WEEKDAYS")
  bio            String
  avatarUrl      String?

  mentorshipRequests MentorshipRequest[]
}

model InvestorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  orgName            String
  investorType       String   @default("VC_FUND")
  investmentStages   String[]
  investmentDomains  String[]
  ticketSizeMin      Float
  ticketSizeMax      Float
  currency           String   @default("PKR")
  portfolioStartups  String[]
  investmentCriteria String
  contactEmail       String
  logo               String?
}

model MentorshipRequest {
  id            String           @id @default(uuid())
  startupId     String
  startup       Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)
  mentorId      String
  mentor        MentorProfile    @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  message       String
  status        MentorshipStatus @default(PENDING)
  scheduledDate DateTime?
  createdAt     DateTime         @default(now())
}

model Workspace {
  id          String   @id @default(uuid())
  projectId   String?
  name        String
  description String
  members     Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channels Channel[]
  tasks    WorkspaceTask[]
  meetings VideoMeeting[]
}

model Channel {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  type        String   @default("GENERAL")
  createdAt   DateTime @default(now())

  messages ChatMessage[]
}

model ChatMessage {
  id          String   @id @default(uuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId    String
  senderName  String
  senderAvatar String?
  content     String
  attachments String[]
  createdAt   DateTime @default(now())
}

model WorkspaceTask {
  id          String     @id @default(uuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  description String
  assignees   String[]
  createdBy   String
  status      TaskStatus @default(TODO)
  priority    String     @default("MEDIUM")
  dueDate     DateTime
  labels      String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model VideoMeeting {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  scheduledAt DateTime
  duration    String
  attendees   String[]
  meetingUrl  String
  notes       String?
  createdAt   DateTime  @default(now())
}
