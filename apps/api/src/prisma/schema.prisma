generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GOVERNMENT
  UNIVERSITY
  COMPANY
  INDIVIDUAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

enum CompanyStage {
  STARTUP
  SME
  ENTERPRISE
}

enum IndividualAvailability {
  OPEN_TO_WORK
  BUSY
  NOT_AVAILABLE
}

enum ProjectType {
  GOVERNMENT_CHALLENGE
  INDUSTRY_CHALLENGE
  RESEARCH_OPPORTUNITY
  HACKATHON
  COMPETITION
  FUNDING_OPPORTUNITY
  COLLABORATION_REQUEST
  OPEN_SOURCE_PROJECT
}

enum OpportunityStatus {
  DRAFT
  OPEN
  IN_REVIEW
  FUNDED
  CLOSED
  COMPLETED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWED
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum PublicationType {
  PAPER
  PATENT
  DATASET
  PROTOTYPE
  IDEA
}

enum AccessType {
  OPEN
  RESTRICTED
  COMMERCIAL
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  RESEARCH_POSITION
  CONTRACT
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  EXPERT
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum JobApplicationStatus {
  APPLIED
  SCREENED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  username      String      @unique
  passwordHash  String
  role          Role
  status        UserStatus  @default(ACTIVE)
  emailVerified Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  governmentProfile GovernmentProfile?
  universityProfile UniversityProfile?
  companyProfile    CompanyProfile?
  individualProfile IndividualProfile?

  opportunities PostedOpportunity[]
  applications  Application[]
  bookmarks     Bookmark[]
  researches    Research[]
  jobPostings   JobPosting[]
  jobApps       JobApplication[]
}

model GovernmentProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName   String
  ministry           String
  jurisdiction       String
  website            String?
  logo               String?
  contactEmail       String
  contactPhone       String?
  verificationStatus String   @default("VERIFIED")
  nationalFocusAreas String[]
}

model UniversityProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  country            String   @default("Pakistan")
  city               String
  ranking            String?
  accreditation      String?
  departments        String[]
  facultiesCount     Int?     @default(0)
  labsCount          Int?     @default(0)
  incubators         String[]
  website            String?
  logo               String?
  verificationStatus String   @default("VERIFIED")
}

model CompanyProfile {
  id                 String       @id @default(uuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  industry           String
  size               String
  stage              CompanyStage @default(STARTUP)
  description        String
  website            String?
  logo               String?
  verificationStatus String       @default("VERIFIED")
  techStack          String[]
}

model IndividualProfile {
  id                String                 @id @default(uuid())
  userId            String                 @unique
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  headline          String
  bio               String
  education         Json                   @default("[]")
  experience        Json                   @default("[]")
  skills            String[]
  researchInterests String[]
  githubUrl         String?
  portfolioUrl      String?
  linkedinUrl       String?
  availability      IndividualAvailability @default(OPEN_TO_WORK)
}

model PostedOpportunity {
  id                String            @id @default(uuid())
  title             String
  description       String
  type              ProjectType
  postedBy          String
  poster            User              @relation(fields: [postedBy], references: [id], onDelete: Cascade)
  domain            String
  budget            Float?
  currency          String            @default("PKR")
  budgetType        String            @default("FIXED")
  deadline          DateTime
  duration          String?
  requiredSkills    String[]
  requiredRoles     String[]
  status            OpportunityStatus @default(OPEN)
  visibility        String            @default("PUBLIC")
  attachments       String[]
  tags              String[]
  milestones        Json              @default("[]")
  featured          Boolean           @default(false)
  viewCount         Int               @default(0)
  applicationCount  Int               @default(0)
  collaboratorCount Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  applications Application[]
  bookmarks    Bookmark[]
}

model Application {
  id               String            @id @default(uuid())
  opportunityId    String
  opportunity      PostedOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantId      String
  applicant        User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  coverLetter      String
  proposedApproach String
  proposedBudget   Float?
  proposedTimeline String?
  attachments      String[]
  status           ApplicationStatus @default(SUBMITTED)
  reviewNotes      String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Bookmark {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   PostedOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())

  @@unique([userId, opportunityId])
}

model Research {
  id                String          @id @default(uuid())
  title             String
  abstract          String
  pdfUrl            String?
  authors           String[]
  affiliations      String[]
  domain            String
  subDomain         String?
  keywords          String[]
  publicationType   PublicationType @default(PAPER)
  publishedDate     DateTime
  journalName       String?
  doi               String?
  externalUrl       String?
  license           String          @default("CC BY 4.0")
  accessType        AccessType      @default(OPEN)
  citations         Int             @default(0)
  downloads         Int             @default(0)
  views             Int             @default(0)
  collaborationOpen Boolean         @default(true)
  fundingRequest    Boolean         @default(false)
  fundingAmount     Float?
  status            String          @default("PUBLISHED")
  postedBy          String
  poster            User            @relation(fields: [postedBy], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  collabInquiries ResearchCollabInquiry[]
}

model ResearchCollabInquiry {
  id           String   @id @default(uuid())
  researchId   String
  research     Research @relation(fields: [researchId], references: [id], onDelete: Cascade)
  inquirerId   String
  inquiryType  String   @default("COMMERCIALIZATION")
  message      String
  contactEmail String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}

model JobPosting {
  id                  String          @id @default(uuid())
  companyId           String
  poster              User            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title               String
  description         String
  type                JobType         @default(FULL_TIME)
  domain              String
  requiredSkills      String[]
  preferredSkills     String[]
  experienceLevel     ExperienceLevel @default(MID)
  salaryMin           Float?
  salaryMax           Float?
  currency            String          @default("PKR")
  salaryType          String          @default("MONTHLY")
  location            String
  remote              Boolean         @default(false)
  hybrid              Boolean         @default(false)
  applicationDeadline DateTime
  startDate           DateTime?
  perks               String[]
  responsibilities    String[]
  requirements        String[]
  status              JobStatus       @default(ACTIVE)
  viewCount           Int             @default(0)
  applicantCount      Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  applications JobApplication[]
}

model JobApplication {
  id             String               @id @default(uuid())
  jobId          String
  job            JobPosting           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId    String
  applicant      User                 @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  coverLetter    String
  resumeUrl      String?
  status         JobApplicationStatus @default(APPLIED)
  notes          String?
  interviewDate  DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  recommendations UniversityRecommendation[]
}

model UniversityRecommendation {
  id             String         @id @default(uuid())
  jobApplicationId String
  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  universityId   String
  studentId      String
  note           String
  createdAt      DateTime       @default(now())
}
